{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Семейный атлас",
  "version": "0.1.0",
  "identifier": "local.family-atlas.desktop",
  "build": {"frontendDist": "../web"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "Семейный атлас", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 650}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {"active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"], "resources": {"../LICENSE": "LICENSE.txt", "../NOTICE.md": "NOTICE.md"}}
}
